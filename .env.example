# SafarAtlas Environment Configuration
# Copy this file to .env.local and fill in your values

# ────────────────────────────────────────
# Email Notifications (Resend.com)
# Get your API key at: https://resend.com/api-keys
# ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to receive lead notifications
ADMIN_EMAIL=admin@safaratlas.com

# ────────────────────────────────────────
# Admin Dashboard Security
# Generate a secure token (e.g., using: openssl rand -hex 32)
# ────────────────────────────────────────
ADMIN_API_TOKEN=your_secure_admin_token_here

# ────────────────────────────────────────
# Site Configuration
# Your production domain (no trailing slash)
# ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://safaratlas.com

# ────────────────────────────────────────
# Optional: Analytics & Monitoring
# ────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
